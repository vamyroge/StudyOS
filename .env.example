# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider (xKiro / 9Router / OmniRoute / OpenRouter / OpenAI-compatible)
# xKiro uses OpenAI-compatible Chat Completions. Keep XKIRO_API_KEY server-side only.
AI_PROVIDER=9router
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=openai/gpt-5.6-sol
# Generic AI_* variables remain available for another OpenAI-compatible provider.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# Embedding
# Supported providers: huggingface, openai-compatible
EMBEDDING_PROVIDER=huggingface
# AITeamVN/Vietnamese_Embedding_v2 is verified by its model card as 1024 dimensions.
# It is not currently deployed by Hugging Face Inference Providers. Use a dedicated
# Hugging Face Inference Endpoint/self-hosted TEI provider and switch to
# openai-compatible with its URL/key, or select an HF Provider-hosted model.
HF_TOKEN=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding_v2
EMBEDDING_DIMENSION=1024

# Required only by the custom migration runner.
DATABASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ADAPTIVE_LEARNING_ENABLED=false
NEXT_PUBLIC_PROACTIVE_AI_ENABLED=false
